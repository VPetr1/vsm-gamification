# Copy to .env and adjust. Every value has a local default in docker-compose.yml,
# so the project also starts without this file.

# PostgreSQL inside Docker (not exposed on the host).
POSTGRES_USER=vsm
POSTGRES_PASSWORD=vsm-local-only
POSTGRES_DB=vsm

# Shared password of the fictional demo accounts created by the seed.
DEMO_PASSWORD=vsm-demo

# Session cookie: lifetime in hours; set COOKIE_SECURE=true when served over HTTPS.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Extra origins allowed to call the API with cookies (comma-separated). Empty = same origin only.
CORS_ORIGINS=

# Host ports.
FRONTEND_PORT=8080
BACKEND_PORT=8000
